# Строка подключения к Neon (Postgres)
DATABASE=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Куда отправлять запросы к моделям
SHADOWURL=https://example.com/shadow     # Darka Shadow 1.0
QUIZIWURL=https://example.com/quiziw     # Darka Quiziw 7.0
NOLDVA=https://example.com/darka02       # Darka 0.2 Enchanted
NOLODIN=https://example.com/darka01      # Darka 0.1

# Необязательно: ключ, который добавится в заголовок Authorization: Bearer ...
# MODEL_API_KEY=
# Необязательно: секрет для подписи сессий (если не задан, берётся из DATABASE)
# AUTH_SECRET=
